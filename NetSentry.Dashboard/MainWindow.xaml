<Window x:Class="NetSentry.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSentry " Height="720" Width="900"
        Background="#000000">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#00FF41"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border BorderBrush="#00FF41" BorderThickness="0,0,0,2" Padding="10">
            <DockPanel>
                <TextBlock Text=">> NET_SENTRY_V2.3 " FontSize="28" FontWeight="Bold" DockPanel.Dock="Left">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00FF41" BlurRadius="15" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="by.Shxdw..." HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" Opacity="0.7"/>
            </DockPanel>
        </Border>

        <!-- LIST -->
        <ListBox Grid.Row="1" x:Name="MachinesList" Background="#050505" BorderThickness="0" Margin="0,15"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Карточка ПК -->
                    <Border BorderBrush="#333" BorderThickness="1" CornerRadius="4" Background="#0A0A0A" Margin="0,5" Padding="15" Width="820">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ЛЕВАЯ КОЛОНКА: ИНФО -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding UserName, StringFormat='USER: {0}'}" Foreground="#888" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding OS}" Foreground="#555" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,10"/>

                               
                                <!-- Статус -->
                                <Border BorderThickness="1" HorizontalAlignment="Left" Padding="5,2" CornerRadius="3" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#222222"/>
                                            <Setter Property="BorderBrush" Value="#555555"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Online">
                                                    <Setter Property="Background" Value="#003300"/>
                                                    <Setter Property="BorderBrush" Value="#00FF41"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OFFLINE"/>
                                                <Setter Property="Foreground" Value="#888888"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Online">
                                                        <Setter Property="Text" Value="ONLINE"/>
                                                        <Setter Property="Foreground" Value="#00FF41"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                    </Border>

                    <!-- Инфо о железе (CPU/GPU) -->
                                <TextBlock Text="HARDWARE SPECS:" FontSize="10" Foreground="#444" Margin="0,5,0,2"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="{Binding CpuTemp, StringFormat='{}{0:F0}°C'}" DockPanel.Dock="Right" Foreground="{Binding CpuTempColor}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CpuName}" FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock Text="{Binding GpuTemp, StringFormat='{}{0:F0}°C'}" DockPanel.Dock="Right" Foreground="{Binding GpuTempColor}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding GpuName}" FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- ПРАВАЯ КОЛОНКА: МЕТРИКИ -->
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">

                                <!-- CPU -->
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="CPU LOAD" Width="70" Foreground="#AAA"/>
                                    <TextBlock Text="{Binding Cpu, StringFormat='{}{0:F0}%'}" DockPanel.Dock="Right" Foreground="White" Width="40" TextAlignment="Right" FontWeight="Bold"/>
                                    <ProgressBar Value="{Binding Cpu}" Maximum="100" Height="6" Background="#222" Foreground="#FF3333" BorderThickness="0"/>
                                </DockPanel>

                                <!-- RAM -->
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="RAM FREE" Width="70" Foreground="#AAA"/>
                                    <TextBlock Text="{Binding RamFree, StringFormat='{}{0:F0} MB'}" DockPanel.Dock="Right" Width="60" Foreground="White" TextAlignment="Right"/>
                                    <ProgressBar Value="{Binding RamFree}" Maximum="16000" Height="6" Background="#222" Foreground="#00AAFF" BorderThickness="0"/>
                                </DockPanel>

                                <!-- Список дисков -->
                                <ItemsControl ItemsSource="{Binding Drives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock Text="{Binding DriveName}" Width="70" Foreground="#AAA"/>
                                                <TextBlock Text="{Binding DisplayText}" DockPanel.Dock="Right" Width="120" Foreground="White" FontSize="10" TextAlignment="Right"/>
                                                <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="6" Background="#222" Foreground="#FFAA00" BorderThickness="0"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>

                        <!-- СЕТЬ: устройства агента -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="10,8"
                                Background="#050505" BorderBrush="#1a3d1a" BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text=">> NETWORK SCAN" FontSize="10" Foreground="#444" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding NetworkDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Ellipse Width="8" Height="8" Fill="#00FF41" Margin="0,2,10,0" VerticalAlignment="Top">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#00FF41" BlurRadius="6" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DisplayLine}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#00FF41"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="> нет устройств с MAC в последнем скане"
                                           FontSize="10" Foreground="#333" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetworkDevices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- FOOTER -->
        <TextBlock Grid.Row="2" Text="> This is a trial program for synchronizing the statistics of one PC with the server and the ability to monitor these statistics on a separate PC...." Foreground="#555" FontSize="10"/>
    </Grid>
</Window>
