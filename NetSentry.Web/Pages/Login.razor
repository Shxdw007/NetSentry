@page "/"
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>NetSentry // AUTH</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="container" style="max-width: 450px;">
        
        <div class="text-center mb-4">
            <h1 style="text-shadow: 0 0 10px #00ff00; letter-spacing: 3px;">NET_SENTRY</h1>
            <p style="color: #00cc00;">> ОЖИДАНИЕ АВТОРИЗАЦИИ...</p>
        </div>

        <div class="card p-4">
            <div class="card-body">
                <div class="form-group mb-3">
                    <label class="form-label">> USER_ID</label>
                    <input class="form-control" @bind="loginModel.Username" placeholder="root" />
                </div>
                
                <div class="form-group mb-4">
                    <label class="form-label">> PASSWORD</label>
                    <input type="password" class="form-control" @bind="loginModel.Password" placeholder="********" />
                </div>

                <button class="btn btn-primary w-100" @onclick="Authorize">
                    [ ИНИЦИАЛИЗАЦИЯ ДОСТУПА ]
                </button>

                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="mt-3 text-center" style="color: @(isError ? "#ff003c" : "#00ff00"); text-shadow: 0 0 5px @(isError ? "#ff003c" : "#00ff00");">
                        > @Message
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // Переменные для привязки данных из полей ввода
    private LoginRequest loginModel = new();
    private string Message = "";
    private bool isError = false; // <-- Вот она, наша пропажа!

    private async Task Authorize()
    {
        try
        {
            isError = false;
            Message = "УСТАНОВКА СОЕДИНЕНИЯ С УЗЛОМ...";

            // Отправляем POST запрос на наш метод логина
            var response = await Http.PostAsJsonAsync("/api/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse<AuthData>>();
                
                if (result != null && result.Success)
                {
                    Message = "[ ДОСТУП РАЗРЕШЕН. ПЕРЕНАПРАВЛЕНИЕ... ]";
                    
                    // Запоминаем токен
                    Http.DefaultRequestHeaders.Authorization =
                        new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", result.Data?.Token);
                    
                    // Делаем небольшую паузу ради крутого эффекта (полсекунды)
                    await Task.Delay(500);

                    // АВТОМАТИЧЕСКИЙ ПЕРЕХОД НА ДАШБОРД!
                    NavManager.NavigateTo("/dashboard");
                }
            }
            else
            {
                isError = true;
                Message = "[ ОШИБКА ]: НЕВЕРНЫЕ УЧЕТНЫЕ ДАННЫЕ (401)";
            }
        }
        catch (Exception)
        {
            isError = true;
            Message = "[ КРИТИЧЕСКАЯ ОШИБКА ]: УЗЕЛ СВЯЗИ НЕДОСТУПЕН";
        }
    }

    // Классы-помощники
    public class LoginRequest { public string Username { get; set; } = ""; public string Password { get; set; } = ""; }
    public class ApiResponse<T> { public bool Success { get; set; } public T? Data { get; set; } }
    public class AuthData { public string Token { get; set; } = ""; public string Role { get; set; } = ""; }
}